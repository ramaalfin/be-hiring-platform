generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid())
  fullName       String
  email          String             @unique
  password       String
  verified       Boolean            @default(false)
  isTwoFAEnabled Boolean            @default(false)
  twoFAEmailCode String?
  twoFAExpiresAt DateTime?
  role           Role               @default(CANDIDATE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  applications   Application[]
  jobs           Job[]
  sessions       Session[]
  verifications  VerificationCode[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  userAgent String?
  expiresAt DateTime? @default(dbgenerated("(now() + '30 days'::interval)"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model VerificationCode {
  id        String   @id @default(uuid())
  userId    String
  type      String
  expiresAt DateTime
  createdAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model Job {
  id                                String        @id @default(uuid())
  jobName                           String
  jobType                           String
  jobDescription                    String
  numberOfCandidateNeeded           Int
  minimumSalary                     String
  maximumSalary                     String
  minimumProfileInformationRequired Json
  createdBy                         String
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt
  applications                      Application[]
  createdByUser                     User          @relation(fields: [createdBy], references: [id])
}

model Application {
  id        String   @id @default(uuid())
  jobId     String
  userId    String
  resume    Json
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  CANDIDATE
}
