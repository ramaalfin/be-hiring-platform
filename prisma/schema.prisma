generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid())
  fullName       String
  email          String             @unique
  password       String
  verified       Boolean            @default(false)
  isTwoFAEnabled Boolean            @default(false)
  twoFAEmailCode String?
  twoFAExpiresAt DateTime?
  role           Role               @default(CANDIDATE)
  isDefaultPassword Boolean         @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  applications   Application[]
  jobs           Job[]
  createdJobs    Job[]              @relation("EmployerJobs")
  statusChanges  ApplicationStatusHistory[]
  sessions       Session[]
  verifications  VerificationCode[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  userAgent String?
  expiresAt DateTime? @default(dbgenerated("(now() + '30 days'::interval)"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationCode {
  id        String   @id @default(uuid())
  userId    String
  type      String
  expiresAt DateTime
  createdAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@index([userId, type])
}

model Job {
  id                                String        @id @default(uuid())
  jobName                           String
  jobType                           String
  jobDescription                    String
  numberOfCandidateNeeded           Int
  minimumSalary                     String
  maximumSalary                     String
  minimumProfileInformationRequired Json
  createdBy                         String
  employerId                        String?
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt
  applications                      Application[]
  createdByUser                     User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  employer                          User?         @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@index([employerId])
  @@index([jobType])
  @@index([createdAt])
  @@index([createdBy, createdAt])
  @@index([employerId, createdAt])
}

model Application {
  id             String                        @id @default(uuid())
  jobId          String
  userId         String
  resume         Json
  status         ApplicationStatus             @default(APPLIED)
  notes          String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  job            Job                           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory  ApplicationStatusHistory[]

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([createdAt])
  @@index([jobId, status])
  @@index([status])
}

model ApplicationStatusHistory {
  id             String      @id @default(uuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus     String
  toStatus       String
  changedBy      String
  changedByUser  User        @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  changedAt      DateTime    @default(now())
  reason         String?

  @@unique([applicationId, changedAt])
  @@index([applicationId])
  @@index([changedAt])
}

enum Role {
  ADMIN
  CANDIDATE
  EMPLOYER
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}
